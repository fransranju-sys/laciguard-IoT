# Ganti PROJECT_ID dengan nama unik kelompokmu (huruf, angka, - dan _)
PROJECT_ID=laciguard_kelompok_XX

# Broker publik HiveMQ: tanpa daftar akun. Jangan kirim data rahasia.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_TLS=true

# Ukuran window (jumlah sampel per kiriman) dan jeda antar sampel (detik)
WINDOW_SIZE=10
SAMPLE_INTERVAL=0.1
